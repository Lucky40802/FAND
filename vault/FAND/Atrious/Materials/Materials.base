filters:
  and:
    - file.inFolder("FAND/Atrious/Materials")
views:
  - type: table
    name: All Materials
    order:
      - file.name
      - realm
      - grade
      - rank
      - itemLevel
      - rarity
      - type
      - property
      - potency
      - price
      - source
      - dropsFrom
      - gatheredBy
      - usedInBlueprints
    sort:
      - property: rank
        direction: ASC
  - type: table
    name: Monster Drops
    filters:
      and:
        - source == "Monster drop"
    order:
      - file.name
      - realm
      - grade
      - rank
      - itemLevel
      - rarity
      - type
      - property
      - potency
      - price
      - source
      - dropsFrom
      - gatheredBy
      - usedInBlueprints
    sort:
      - property: rank
        direction: ASC
  - type: table
    name: Gathered
    filters:
      and:
        - source == "Gathered"
    order:
      - file.name
      - realm
      - grade
      - rank
      - itemLevel
      - rarity
      - type
      - property
      - potency
      - price
      - source
      - dropsFrom
      - gatheredBy
      - usedInBlueprints
    sort:
      - property: rank
        direction: ASC
  - type: table
    name: Blueprint Materials
