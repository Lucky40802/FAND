filters:
  and:
    - profession == "Tailoring"
views:
  - type: table
    name: Tailoring Blueprints
    order:
      - file.name
      - specialty
      - category
      - level
      - rarity
      - damage
      - ac
      - armorType
      - slot
      - materials
      - property
      - potency
    sort:
      - property: level
        direction: ASC
