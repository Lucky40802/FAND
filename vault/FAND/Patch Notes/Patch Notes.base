filters:
  and:
    - file.inFolder("FAND/Patch Notes")
views:
  - type: table
    name: All Versions
    order:
      - file.name
      - version
      - date
      - title
      - areas
      - added
      - changed
      - fixed
    sort:
      - property: version
        direction: DESC
  - type: table
    name: Armor Class
    filters:
      and:
        - areas.contains("Armor Class")
    order:
      - file.name
      - version
      - date
      - title
      - areas
      - added
      - changed
      - fixed
    sort:
      - property: version
        direction: DESC
